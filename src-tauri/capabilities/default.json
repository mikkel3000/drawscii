{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Edit .txt diagrams inside folders the user picks.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists"
  ]
}
