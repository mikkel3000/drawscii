{
  "name": "asciiflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts playwright.config.ts styles.css README.md"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "~2.11.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
